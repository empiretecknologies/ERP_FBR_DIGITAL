  <Code>Function NumberToWords(ByVal number As Long) As String
    If number = 0 Then
        Return "Zero"
    End If
    
    If number &lt; 0 Then
        Return "Minus " &amp; NumberToWords(Math.Abs(number))
    End If
    
    Dim words As String = ""
    
    ' Millions
    If (number \ 1000000) &gt; 0 Then
        words &amp;= NumberToWords(number \ 1000000) &amp; " Million "
        number = number Mod 1000000
    End If
    
    ' Thousands
    If (number \ 1000) &gt; 0 Then
        words &amp;= NumberToWords(number \ 1000) &amp; " Thousand "
        number = number Mod 1000
    End If
    
    ' Hundreds
    If (number \ 100) &gt; 0 Then
        words &amp;= NumberToWords(number \ 100) &amp; " Hundred "
        number = number Mod 100
    End If
    
    ' Remaining Tens &amp; Units
    If number &gt; 0 Then
        If words &lt;&gt; "" Then
            ' Proper spacing and lower-case "and" for clean look
            words = words.Trim() &amp; " and "
        End If
        
        Dim unitsMap As String() = {"Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"}
        Dim tensMap As String() = {"Zero", "Ten", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"}
        
        If number &lt; 20 Then
            words &amp;= unitsMap(number)
        Else
            words &amp;= tensMap(number \ 10)
            If (number Mod 10) &gt; 0 Then
                words &amp;= "-" &amp; unitsMap(number Mod 10)
            End If
        End If
    End If
    
    ' Clean extra spaces at boundaries
    Return words.Trim()
End Function</Code>
