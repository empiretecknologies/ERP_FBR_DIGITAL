<style>
    #SodaPickGridContainer .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > tr > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > tr > td {
        background-color: #055a87 !important;
        color: white;
    }
</style>
<div class="card">
    <div class="card-header">
        <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
            <i class="fa fa-search"></i> Quick Search
        </button>
        <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnNew">
            <i class="fa fa-plus"></i> Add New
        </button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <input id="ID" hidden />
            <input id="ACT_CODE" hidden />
            <input id="SACODE" hidden />
            <input id="partyhidden" hidden />
            <input id="acthidden" hidden />
            <input id="salesmanhidden" hidden />
            <input id="itemIdHidden" hidden />
            <div class="col-xl-10">
                <div class="row">
                    <div class="col-xl-3">
                        <label class="form-label" for="Code">Code:</label>
                        <input class="form-control" id="Code" readonly type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="ASTATUS">Status:</label>
                        <div id="ASTATUS"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="V_DATE">Transaction Date:</label>
                        <input class="form-control" id="V_DATE" type="date" onkeydown="empr_helper.HandleTabFocusToSelectBox(event, '#PARTY_CODE')" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
                    </div>
                    <div class="col-xl-3 vHide">
                        <label class="form-label" for="VOUCHER_NO">Transaction #:</label>
                        <input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
                    </div>

                    <div class="col-xl-3 d-none">
                        <label class="form-label" for="ORDER_TYPE">ORDER_TYPE:</label>
                        <input class="form-control" id="ORDER_TYPE" type="text" readonly autocomplete="off">
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-3" onkeydown="empr_helper.MoveFocusToGrid(event, '#DetailContainer', 0, 'iteM_CODE')">
                        <label class="form-label" for="PARTY_CODE">Party Name:</label>
                        <div id="PARTY_CODE"></div>
                    </div>
                    <div class="col-xl-3 d-none">
                        <div class="row">
                            <div class="col-xl-6 d-none">
                                <label class="form-label" for="PARTY_BALANCE">Party Balance:</label>
                                <input class="form-control" id="PARTY_BALANCE" type="text" autocomplete="off">
                            </div>
                            <div class="col-xl-6 d-none">
                                <label class="form-label" for="TERMS">Pay Terms:</label>
                                <input class="form-control" onkeydown="empr_helper.HandleTabFocus(event, '#REF') id="TERMS" type="text" autocomplete="off">
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 d-none">
                        <label class="form-label" for="DISC">Disc %:</label>
                        <input class="form-control" id="DISC" type="text" autocomplete="off" />
                    </div>

                    <div class="col-xl-3">
                        <label class="form-label" for="BTYPE">Pay Type:</label>
                        <div id="BTYPE"></div>
                    </div>
                    <div class="col-xl-3 d-none">
                        <label class="form-label" for="Currency">Currency:</label>
                        <div id="Currency"></div>
                    </div>

                    <div class="col-xl-3 d-none">
                        <label class="form-label" for="Rate">Rate:</label>
                        <input class="form-control" id="Rate" type="text" autocomplete="off" oninput="empr_helper.EnhancedDecimalFieldValidation(this)">
                    </div>

                    <div class="col-xl-3">
                        <label class="form-label" for="REF">Refrence #:</label>
                        <input class="form-control" id="REF" type="text" onkeydown="empr_helper.HandleTabFocus(event, '#REMARKS') autocomplete="off">
                    </div>

                    <div class="col-xl-3">
                        <label class="form-label" for="DOC">Doc :</label>
                        <input type="hidden" value="" id="hdnDOC" />

                        <div class="input-group my-doc-input-group">
                            <input type="file" name="DOC" id="DOC" class="d-none" onchange=" empr_PurchaseBill.UploadDoc()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />

                            <input type="text" id="DOCName" class="form-control my-doc-text" placeholder="No File" readonly />

                            <button type="button" class="btn my-doc-browse" onclick="$('#DOC').click()">Browse</button>
                            <a href="javascript:;" class="my-doc-eye" id="openDoc" onclick=" empr_PurchaseBill.OpenDoc()"><i class="fa fa-eye my-eye-btn"></i></a>
                        </div>
                    </div>

                    <div class="col-xl-3 d-none">
                        <label class="form-label" for="CARTAGE">Cartage:</label>
                        <input class="form-control" id="CARTAGE" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
                    </div>

                    <div class="col-xl-3 d-none">
                        <label class="form-label" for="WAREHOUSE">Warehouse:</label>
                        <div id="WAREHOUSE"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-6">
                        <label class="form-label" for="REMARKS">Comment:</label>
                        <textarea class="form-control" id="REMARKS" rows="1" type="text" onkeydown="empr_helper.MoveFocusToGrid(event, '#DetailContainer', 0, 'iteM_CODE') autocomplete="off"></textarea>
                    </div>
                    <div class="col-xl-6">
                        <label class="form-label" for="FBR_RES">FBR Responce:</label>
                        <input class="form-control" id="FBR_RES" type="text" readonly autocomplete="off">
                    </div>
                </div>
               
            </div>

            <div class="col-xl-2">
                <div class="">
                    <div class="text-center p-2">
                        <div class="image-box">
                            @* <img id="empProfileImgFinal" src="~/Client/Company/default.jpg" /> *@
                            <img id="qrImg" style="width: 150px;" src="~/Client/Company/notPostedYet.jpg" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-12 pt-1 d-flex justify-content-end align-items-center gap-2">
           @*  <button type="button" class="btn btn-primary" id="BtnSodaPick">
                <i class="fa fa-search"></i> Pick Data
            </button> *@

            <button type="button" id="BtnPrint" class="btn btn-success btn-print waves-effect waves-light">
                <i class="fa fa-print"></i> Print
            </button>

            <button type="button" class="btn btn-primary" id="BtnfBRpOST">
                Post To FBR
            </button>

           @*  <button type="button" id="BtnPrintFBR" class="btn btn-success btn-print waves-effect waves-light">
                <i class="fa fa-print"></i> Print
            </button> *@

            <span id="verifiedText" class="verified-label" style="display:none;">
                ✔ Verified
            </span>
        </div>

        <ul class="nav nav-tabs nav-primary" id="pills-warningtab" role="tablist">
            <li class="nav-item detailInfo">
                <a class="nav-link active" id="pills-warninghome-tab" data-bs-toggle="pill"
                   href="#pills-warninghome" role="tab" aria-controls="pills-warninghome" aria-selected="true">
                    Detail Info
                </a>
            </li>
            <li class="nav-item d-none" id="charges-tab-li">
                <a class="nav-link" id="pills-warningsummary-tab" data-bs-toggle="pill"
                   href="#pills-warningsummary" role="tab" aria-controls="pills-warningsummary" aria-selected="false">
                    Charges
                </a>
            </li>
        </ul>

        <div class="tab-content mt-10" id="pills-warningtabContent">
            <!-- Detail Tab -->
            <div class="tab-pane fade show active" id="pills-warninghome" role="tabpanel"
                 aria-labelledby="pills-warninghome-tab">
                <div class="table-responsive">
                    <div id="DetailContainer"></div>
                </div>
                <div class="col-xl-12 text-end pt-5 pb-5 pr-10">
                    <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
                    <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
                </div>
            </div>

            <!-- Charges -->
            <div class="tab-pane fade" id="pills-warningsummary" role="tabpanel" aria-labelledby="pills-warningsummary-tab">
                <div class="table-responsive">
                    <div id="ChargesGridContainer"></div>
                </div>
                <div class="col-xl-12 text-end pt-5 pb-5 pr-10">
                    <button type="button" id="BtnChargesSave" class="mr-5 btn btn-primary btn-print waves-effect waves-light float-end">
                        <i class="fa fa-print"></i> Save Charges
                    </button>
                </div>

            </div>
        </div>

    </div>


@* quick search *@
    <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <div id="gridContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>


    <div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-10">
                        <div class="row">
                            <div class="col-xl-4">
                                <label class="form-label" for="ReportType">ReportType:</label>
                                <div id="ReportType"></div>
                            </div>
                            <div class="col-xl-2 mt-20">
                                <button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
                                    <i class="fa fa-file-arrow-down"></i> Get Report
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 mt-3">
                        <div class="card text-left" id="ModalBody"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="SodaPickModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Pick Soda</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body customHighlightForModifiedCells">
                                <div class="table-responsive">
                                    <div id="SodaPickGridContainer"></div>
                                </div>
                                <div class="pt-3 text-end">
                                    <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnAddSodaToDelivery">
                                        <i class="fa fa-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>


    <input type="hidden" id="department_hidden" />
    <input type="hidden" id="displayExpr_department" />

@section LinkScriptSection {
        <script type="text/javascript">
            // var ItemIds = @Html.Raw(Json.Serialize(ViewBag.ItemIds));
            // var Salesman = @Html.Raw(Json.Serialize(ViewBag.Salesman));

            var PartyType = @Html.Raw(Json.Serialize(ViewBag.PartyType));
            var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
            var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
            // var Colors = @Html.Raw(Json.Serialize(ViewBag.Colors));
            // var Sizes = @Html.Raw(Json.Serialize(ViewBag.Sizes));
            // var Grades = @Html.Raw(Json.Serialize(ViewBag.Grades));
            // var Regions = @Html.Raw(Json.Serialize(ViewBag.Regions));
            var Warehouse = @Html.Raw(Json.Serialize(ViewBag.Warehouse));
            var Lots = @Html.Raw(Json.Serialize(ViewBag.Lots));
            var Type = @Html.Raw(Json.Serialize(ViewBag.Type));
            var typeForm = @Html.Raw(Json.Serialize(ViewBag.FormType));
            var CompCond = @Html.Raw(Json.Serialize(ViewBag.CompCond));
            var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
            var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
            var fbrType = @Html.Raw(Json.Serialize(ViewBag.fbrType));
            var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
            var Parties = @Html.Raw(Json.Serialize(ViewBag.Parties));
            var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
            var dcType = @Html.Raw(Json.Serialize(ViewBag.dcType));
            var stkStatus = @Html.Raw(Json.Serialize(ViewBag.stkStatus));
            var AllCharges = @Html.Raw(Json.Serialize(ViewBag.AllCharges));
            var DefaultCharges = @Html.Raw(Json.Serialize(ViewBag.DefaultCharges));
        </script>
        <script src="~/js/customjs/empr_PurchaseBill.js" asp-append-version="true"></script>
        <script type="text/javascript">
            $(function () {
                empr_PurchaseBill.InitEvents();
                  empr_helper.EnableShortCutKeys('#BtnSave', '#BtnNew', '#BtnDelete', '#BtnQuickSearch', '#Code', '#DetailContainer', 0, 'custoM_ACT_CODE');
            });
        </script>
}
