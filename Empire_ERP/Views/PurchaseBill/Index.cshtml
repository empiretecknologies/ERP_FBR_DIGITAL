        <script type="text/javascript">
            $(function () {
                empr_PurchaseBill.InitEvents();
                empr_PurchaseBill_InvoiceBulkUpload.InitEvents();
                  empr_helper.EnableShortCutKeys('#BtnSave', '#BtnNew', '#BtnDelete', '#BtnQuickSearch', '#Code', '#DetailContainer', 0, 'custoM_ACT_CODE');

                function pbFormatNumber(value) {
                    var number = parseFloat(value);
                    if (isNaN(number)) {
                        number = 0;
                    }
                    return number.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }

                function pbRemoveGridOwnTotal() {
                    try {
                        $('#DetailContainer .dx-datagrid-total-footer, #ChargesGridContainer .dx-datagrid-total-footer, #DetailContainer .dx-footer-row, #ChargesGridContainer .dx-footer-row').hide();
                        ['#DetailContainer', '#ChargesGridContainer'].forEach(function (id) {
                            var inst = $(id).data('dxDataGrid');
                            if (!inst || inst._pbOwnTotalRemoved) {
                                return;
                            }
                            var summary = inst.option('summary');
                            if (summary && summary.totalItems && summary.totalItems.length) {
                                inst.option('summary.totalItems', []);
                            }
                            inst._pbOwnTotalRemoved = true;
                        });
                    } catch (ex) {
                    }
                }

                function pbUpdateSummaryBar() {
                    try {
                        var countEl = document.getElementById('pbSumCount');
                        if (!countEl) {
                            return;
                        }
                        var grid = $('#DetailContainer').data('dxDataGrid');
                        if (!grid) {
                            return;
                        }
                        var rows = grid.option('dataSource') || [];
                        var count = 0;
                        var qty = 0;
                        var amt = 0;
                        var tax = 0;
                        var net = 0;
                        for (var i = 0; i < rows.length; i++) {
                            var row = rows[i];
                            if (!row || row.iteM_CODE === '' || row.iteM_CODE === null || row.iteM_CODE === undefined) {
                                continue;
                            }
                            count += 1;
                            qty += parseFloat(row.qty) || 0;
                            amt += parseFloat(row.amt) || 0;
                            tax += parseFloat(row.taX_AMT) || 0;
                            net += parseFloat(row.neT_AMT) || 0;
                        }
                        countEl.textContent = count;
                        $('#pbSumQty').text(pbFormatNumber(qty));
                        $('#pbSumAmt').text(pbFormatNumber(amt));
                        $('#pbSumTax').text(pbFormatNumber(tax));
                        $('#pbSumNet').text(pbFormatNumber(net));
                    } catch (ex) {
                    }
                }

                setInterval(function () {
                    pbRemoveGridOwnTotal();
                    pbUpdateSummaryBar();
                    try {
                        var inst = $('#DetailContainer').data('dxDataGrid');
                        var $items = $('.pb-items-card');
                        if (!inst || !$items.length) {
                            return;
                        }
                        var expected = Math.floor(($('#pills-warninghome > .table-responsive').height() || 0));
                        var current = parseFloat(inst.option('height')) || 0;
                        if (expected > 110 && Math.abs(current - expected) > 24) {
                            pbFitFormToPage();
                        }
                    } catch (ex) {
                    }
                }, 600);

                function pbFitFormToPage() {
                    try {
                        var $form = $('.pb-form');
                        if (!$form.length) {
                            return;
                        }
                        var $side = $('.rightsidecontent');
                        var top = $form.offset().top || 0;
                        var bottom = window.innerHeight;
                        if ($side.length) {
                            bottom = $side.offset().top + $side.innerHeight();
                        }
                        var available = Math.floor(bottom - top - 4);
                        if (available > 280) {
                            $form.css({
                                height: available + 'px',
                                maxHeight: available + 'px'
                            });
                        }

                        var $wrap = $('#pills-warninghome > .table-responsive');
                        var gridH = Math.floor($wrap.height() || 0);
                        if (gridH < 110) {
                            var $items = $form.find('.pb-items-card');
                            gridH = Math.floor(($items.height() || 0) - ($items.find('.pb-items-head').outerHeight() || 0) - ($items.find('.pb-summary-bar').outerHeight() || 0) - 2);
                        }
                        if (gridH < 110) {
                            gridH = 110;
                        }
                        var inst = $('#DetailContainer').data('dxDataGrid');
                        if (inst) {
                            pbRemoveGridOwnTotal();
                            inst.option('height', gridH);
                            if (inst.updateDimensions) {
                                inst.updateDimensions();
                            } else if (inst.resize) {
                                inst.resize();
                            }
                        }
                        var charges = $('#ChargesGridContainer').data('dxDataGrid');
                        if (charges) {
                            charges.option('height', gridH);
                            if (charges.updateDimensions) {
                                charges.updateDimensions();
                            }
                        }
                    } catch (ex) {
                    }
                }

                pbRemoveGridOwnTotal();
                setTimeout(pbFitFormToPage, 400);
                setTimeout(pbRemoveGridOwnTotal, 200);
                setTimeout(pbRemoveGridOwnTotal, 800);
                setTimeout(pbFitFormToPage, 1000);
                $(window).on('resize', pbFitFormToPage);

                $(document).on('shown.bs.modal', '#QuickSearchModal', function () {
                    try {
                        var g = $('#gridContainer').dxDataGrid('instance');
                        if (g) {
                            g.option('height', Math.min(460, window.innerHeight - 180));
                            if (g.updateDimensions) {
                                g.updateDimensions();
                            }
                        }
                    } catch (ex) {
                    }
                });
            });
        </script>
}
